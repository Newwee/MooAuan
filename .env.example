# ==========================================
# DUO POP / MooAuan Environment Variables
# ==========================================

# Next.js Public Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional for Cloud DB & Auth)
# If omitted or not configured, DUO POP automatically runs with its built-in resilient in-memory SSE engine.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Passcode for Admin Mode (/admin)
# Defaults to mooauan2026 if not set
ADMIN_PASSCODE=mooauan2026
ADMIN_USER_IDS=admin_master,admin_owner
